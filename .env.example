# URL del frontend en producción (Vercel). Se agrega a los orígenes permitidos por CORS.
FRONTEND_URL=https://coestudia-frontend.vercel.app

# Base de datos. Si no se define, se usa SQLite en ./coestudia.db (desarrollo local).
# En producción es la connection string de Neon (Dashboard → Connection string).
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/coestudia?sslmode=require

# Clave para firmar las sesiones (JWT). Obligatoria en producción; genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Correo con Brevo. Sin BREVO_API_KEY los correos no se envían: el enlace aparece en la consola.
BREVO_API_KEY=
MAIL_FROM=no-reply@coestudia.cl
